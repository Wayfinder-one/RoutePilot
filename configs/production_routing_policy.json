{
  "kind": "sr-routing-policy",
  "version": 4,
  "name": "默认决策组",
  "timezone": "Asia/Shanghai",
  "sticky": {
    "enabled": true,
    "ttl_seconds": 1800
  },
  "questions": {
    "route": {
      "type": "choice",
      "instructions": "你是一个模型路由器。下面是一条用户请求，请根据每个模型的能力说明，选择最合适处理这条请求的模型。",
      "options": [
        {
          "key": "fast",
          "label": "轻量模型（qwen3.8-27B）",
          "capability": "速度最快、成本最低。适合简单短小的请求：闲聊、简单事实问答、格式转换、短翻译、信息提取、简单提醒。复杂任务容易出错。"
        },
        {
          "key": "standard",
          "label": "标准模型（DeepSeek-v4-flash）",
          "capability": "速度与质量均衡。适合中等复杂度请求：写作、总结、简单排错、方案对比、表格整理、一般计划与轻度数据分析。"
        },
        {
          "key": "strong",
          "label": "增强模型（kimi K3.1 pro）",
          "capability": "能力最强但较慢、成本高。适合复杂请求：长文档分析、多约束方案设计、复杂代码与故障排查、统计建模、风险判断与深度决策。"
        }
      ]
    }
  },
  "targets": {
    "fast": {
      "models": [
        {"model": "qwen3-8b"}
      ]
    },
    "standard": {
      "models": [
        {"model": "deepseek-v3"}
      ]
    },
    "strong": {
      "models": [
        {"model": "qwen3-32b"}
      ]
    },
    "safe": {
      "models": [
        {"model": "qwen3-8b"}
      ]
    }
  },
  "rules": [
    {
      "name": "主问题选择轻量模型",
      "when": {"answer": "route.selected", "eq": "fast"},
      "target": "fast"
    },
    {
      "name": "主问题选择标准模型",
      "when": {"answer": "route.selected", "eq": "standard"},
      "target": "standard"
    },
    {
      "name": "主问题选择增强模型",
      "when": {"answer": "route.selected", "eq": "strong"},
      "target": "strong"
    }
  ],
  "fallback": "safe"
}
