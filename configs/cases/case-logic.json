{
  "kind": "sr-routing-graph",
  "version": 4,
  "name": "案例四 · 请求条件与逻辑门",
  "timezone": "Asia/Shanghai",
  "sticky": {
    "enabled": false,
    "ttl_seconds": 1800
  },
  "root": {
    "id": "root",
    "type": "graph",
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "title": "开始"
      },
      {
        "id": "c-keyword",
        "type": "condition",
        "source": "text",
        "title": "关键词 · 告警/抢修/故障/紧急",
        "contains_any": [
          "告警",
          "抢修",
          "故障",
          "紧急"
        ]
      },
      {
        "id": "c-fault",
        "type": "condition",
        "source": "text",
        "title": "关键词 · 故障/抢修",
        "contains_any": [
          "故障",
          "抢修"
        ]
      },
      {
        "id": "c-day",
        "type": "condition",
        "source": "periods",
        "title": "时段 · 白天",
        "periods": [
          "白天"
        ]
      },
      {
        "id": "c-night",
        "type": "condition",
        "source": "periods",
        "title": "时段 · 夜间",
        "periods": [
          "夜间"
        ]
      },
      {
        "id": "q-urgent",
        "type": "question",
        "question_type": "noul",
        "title": "是否紧急",
        "instructions": "这条用户请求描述的告警或故障是否紧急，是否需要立即处置？"
      },
      {
        "id": "q-severity",
        "type": "question",
        "question_type": "score",
        "title": "严重度",
        "instructions": "请评估这条用户请求所描述问题的严重程度：1 分表示轻微咨询，10 分表示重大事故。",
        "criteria": [
          1,
          3,
          6,
          8,
          10
        ]
      },
      {
        "id": "g-and-urgent",
        "type": "logic",
        "operator": "and",
        "title": "与门 · 关键词且紧急"
      },
      {
        "id": "g-or-dayfault",
        "type": "logic",
        "operator": "or",
        "title": "或门 · 白天或故障"
      },
      {
        "id": "g-and-night",
        "type": "logic",
        "operator": "and",
        "title": "与门 · 夜间且高严重度"
      },
      {
        "id": "g-and-severity",
        "type": "logic",
        "operator": "and",
        "title": "与门 · 严重度中段（4–8）"
      },
      {
        "id": "t-emergency",
        "type": "target",
        "title": "紧急处置（industry-energy）",
        "priority": 5,
        "models": [
          {
            "model": "industry-energy",
            "reasoning": null
          }
        ]
      },
      {
        "id": "t-oncall",
        "type": "target",
        "title": "值班响应（ha-general）",
        "priority": 4,
        "models": [
          {
            "model": "ha-general",
            "reasoning": null
          }
        ]
      },
      {
        "id": "t-review",
        "type": "target",
        "title": "排期复审（ha-general）",
        "priority": 3,
        "models": [
          {
            "model": "ha-general",
            "reasoning": null
          }
        ]
      },
      {
        "id": "t-normal",
        "type": "target",
        "title": "常规处理（ha-general）",
        "priority": 2,
        "models": [
          {
            "model": "ha-general",
            "reasoning": null
          }
        ]
      },
      {
        "id": "t-fallback",
        "type": "target",
        "title": "异常兜底（ha-general）",
        "priority": 1,
        "models": [
          {
            "model": "ha-general",
            "reasoning": null
          }
        ]
      }
    ],
