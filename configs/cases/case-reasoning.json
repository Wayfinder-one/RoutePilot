{
  "kind": "sr-routing-graph",
  "version": 4,
  "name": "案例三 · 推理等级",
  "timezone": "Asia/Shanghai",
  "sticky": {
    "enabled": false,
    "ttl_seconds": 1800
  },
  "root": {
    "id": "root",
    "type": "graph",
    "nodes": [
      {
        "id": "start",
        "type": "start",
        "title": "开始"
      },
      {
        "id": "depth",
        "type": "question",
        "question_type": "score",
        "title": "推理深度",
        "instructions": "请评估这条用户请求需要的推理深度：1 分表示简单直接、几乎不需要思考，10 分表示需要复杂的多步推理与权衡。",
        "criteria": [
          1,
          3,
          6,
          8,
          10
        ]
      },
      {
        "id": "and-mid",
        "type": "logic",
        "operator": "and",
        "title": "与门 · 中等推理（4 < 分 < 8）"
      },
      {
        "id": "deep-target",
        "type": "target",
        "title": "深度推理（reason-deepseek:max）",
        "priority": 3,
        "models": [
          {
            "model": "reason-deepseek",
            "reasoning": "max"
          }
        ]
      },
      {
        "id": "standard-target",
        "type": "target",
        "title": "标准推理（reason-openai:medium）",
        "priority": 2,
        "models": [
          {
            "model": "reason-openai",
            "reasoning": "medium"
          }
        ]
      },
      {
        "id": "light-target",
        "type": "target",
        "title": "轻量直答（reason-qwen:off）",
        "priority": 1,
        "models": [
          {
            "model": "reason-qwen",
            "reasoning": "off"
          }
        ]
      }
    ],
    "edges": [
      {
        "id": "e-start-depth",
        "source": "start",
        "source_port": "out",
        "target": "depth",
        "target_port": "in_1",
        "condition": null
      },
      {
        "id": "e-depth-deep",
        "source": "depth",
        "source_port": "value",
        "target": "deep-target",
        "target_port": "in_1",
        "condition": {
          "op": "gte",
          "value": 8
        }
      },
      {
        "id": "e-depth-mid-gt",
        "source": "depth",
        "source_port": "value",
        "target": "and-mid",
        "target_port": "in_1",
        "condition": {
          "op": "gt",
          "value": 4
        }
      },
      {
        "id": "e-depth-mid-lt",
        "source": "depth",
        "source_port": "value",
        "target": "and-mid",
        "target_port": "in_2",
        "condition": {
          "op": "lt",
          "value": 8
        }
      },
      {
        "id": "e-mid-standard",
        "source": "and-mid",
        "source_port": "out",
        "target": "standard-target",
        "target_port": "in_1",
        "condition": null
      }
    ],
    "error_fallback": "light-target"
  },
  "backends": {
    "providers": [
      {
        "name": "demo-tap",
        "base_url": "http://127.0.0.1:9300/v1",
        "key_env": "",
        "reasoning_format": "openai"
      }
    ],
    "models": [
      {
        "id": "reason-deepseek",
        "upstream": "reason-base",
        "provider": "demo-tap",
        "profile": {
          "domains": [],
          "tier": "large",
          "capability": "推理等级模型（deepseek 方言）：thinking + reasoning_effort，支持高/最高档",
          "reasoning": {
            "format": "deepseek",
            "efforts": {
              "high": "high",
              "max": "max"
            },
            "default": "high"
          }
        }
      },
      {
        "id": "reason-openai",
        "upstream": "reason-base",
        "provider": "demo-tap",
        "profile": {
          "domains": [],
          "tier": "large",
          "capability": "推理等级模型（openai 方言）：reasoning_effort 低/中/高三档，默认中等",
          "reasoning": {
            "format": "openai",
            "efforts": {
              "low": "low",
              "medium": "medium",
              "high": "high"
            },
            "default": "medium"
          }
        }
      },
      {
        "id": "reason-qwen",
        "upstream": "reason-base",
        "provider": "demo-tap",
        "profile": {
          "domains": [],
          "tier": "large",
          "capability": "推理等级模型（qwen-chat-template 方言）：off/on 思考开关，默认关闭思考",
          "reasoning": {
            "format": "qwen-chat-template",
            "efforts": {
              "off": null,
              "on": null
            },
            "default": "off"
          }
        }
      }
    ]
  },
  "jev": {
    "id": "demo-jev",
    "base_url": "http://127.0.0.1:30104",
    "model": "d1-2B",
    "key_env": "",
    "timeout_seconds": 10.0,
    "instructions": "你是一个模型路由器。下面是一条用户请求，请根据每个模型的能力说明，选择最合适处理这条请求的模型。",
    "state_template": "【待判断的用户请求】\n{request}\n\n【任务】请选择最合适处理这条请求的模型。"
  },
  "jev_window": {
    "input_tokens": 2048,
    "context_tokens": 4096
  },
  "time_periods": [],
