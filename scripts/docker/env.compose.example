# Example environment for the standalone compose form (scripts/docker/compose.yml).
# Non-secret values only: the kernel JEV key comes from the shell/CI secret
# store (compose reads it from the environment) and must never be committed.
#
# MANDATORY: the console deployment seeds its first administrator from
# ROUTER_ADMIN_EMAIL / ROUTER_ADMIN_PASSWORD and has NO default credentials.
# `docker compose` refuses to render/start when either variable is missing, so
# export real values in your shell or CI secret store before running:
#   export ROUTER_ADMIN_EMAIL='...'; export ROUTER_ADMIN_PASSWORD='...'
# The empty values below are placeholders only — never commit real credentials.
#
# The console publishes only its public listener on host loopback
# (127.0.0.1:8401 by default). The kernel event receiver listens on container
# port 8400, which is deliberately NOT published; change the bind in
# compose.yml only if you really mean to expose the console to other hosts.
#
# Usage (the two mandatory values must come from the shell/CI secret store, not
# this file — empty placeholders below make compose refuse to render):
#   ROUTER_ADMIN_EMAIL='...' ROUTER_ADMIN_PASSWORD='...' \
#     docker compose --env-file env.compose.example -f compose.yml config
CORE_IMAGE=192.168.95.133:30002/sandlake-deploy/routepilot-core:latest
CONSOLE_IMAGE=192.168.95.133:30002/sandlake-deploy/routepilot-console:latest
ROUTER_JEV_API_KEY=
ROUTER_ADMIN_EMAIL=
ROUTER_ADMIN_PASSWORD=
